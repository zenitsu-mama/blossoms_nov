{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:local"
      ],
      "port": 3001,
      "url": "http://127.0.0.1:3001"
    },
    {
      "name": "dist-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--port", "4173", "--strictPort"],
      "port": 4173
    }
  ]
}
